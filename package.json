{
  "name": "kubernetes-architecture-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.static.config.ts --host 127.0.0.1",
    "build": "vinext build",
    "build:static": "vite build --config vite.static.config.ts",
    "preview:static": "vite preview --config vite.static.config.ts --host 127.0.0.1",
    "start": "wrangler dev --config dist/server/wrangler.json --local --ip 127.0.0.1",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-static --ignore-pattern .next --ignore-pattern .vinext --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test app/data/*.test.ts app/lib/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:static": "node scripts/static-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:static && npm run smoke:static"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.12",
    "vite": "8.3.1",
    "wrangler": "4.141.0"
  },
  "type": "module"
}
